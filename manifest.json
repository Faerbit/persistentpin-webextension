{

  "description": "__MSG_extensionDescription__",
  "manifest_version": 2,
  "name": "PersistentPin",
  "version": "1.2.0",
  "homepage_url": "https://github.com/Faerbit/persistentpin-webextension",

  "options_ui": {
      "page": "src/options.html"
  },

  "background": {
    "page": "src/background.html"
  },

  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],

  "default_locale": "en",

  "browser_specific_settings": {
      "gecko": {
          "id": "{b8f5b973-7a28-4787-8e94-fdb7504e3991}",
          "strict_min_version": "142.0",
          "data_collection_permissions": {
            "required": ["none"]
          }
      }
  }
}
